# Copy to .env (which git ignores) and fill in. Never commit .env.

# Embeddings + answers via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Or direct OpenAI instead (only used if no OpenRouter key is set)
# OPENAI_API_KEY=

# Optional: force a provider: openrouter | openai | fake
# EMBEDDINGS=openrouter

# Optional: LangSmith tracing (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=hdb-rental-rag

# Optional: crawler contact for the User-Agent
# CRAWLER_CONTACT=you@example.com
